# Server-only secrets (never NEXT_PUBLIC_ — API routes only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_PLACES_API_KEY=

# Instagram reel resolver (SocialKit). Without it, Instagram URLs fall back
# to link metadata + pasted caption. Get a key at https://www.socialkit.dev
# (free tier: 20 credits; ~1 credit per reel at 480p).
SOCIALKIT_API_KEY=

# Client map embed key (domain-restricted, Maps Embed API only).
# The app works without it (shows "Open in Google Maps" links), but the
# inline map iframe needs it.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
